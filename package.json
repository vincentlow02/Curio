{
  "name": "curio",
  "version": "1.0.0",
  "private": true,
  "description": "A Tokyo collectible research agent with structured AI identification and deterministic price references",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "tsx scripts/analyze-image.ts",
    "price-reference": "tsx scripts/price-reference.ts",
    "daytona-smoke": "tsx scripts/daytona-smoke.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@daytona/sdk": "0.203.0",
    "ajv": "^8.20.0",
    "dotenv": "17.4.2",
    "geist": "^1.7.2",
    "next": "16.3.0",
    "openai": "6.47.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "fast-uri": "3.1.4",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "tar": "7.5.22"
  }
}
