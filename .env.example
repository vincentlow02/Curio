QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=your-low-cost-qwen-text-model

# Optional website analytics. Leave blank to disable either provider.
# GA4: Admin > Data streams > Web > Measurement ID (starts with G-)
# Clarity: Settings > Setup > Project ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Web demo access. Never prefix this with NEXT_PUBLIC_.
DEMO_ACCESS_CODE=replace-with-a-long-demo-code
WEB_USE_FIXTURE=false
MAX_UPLOAD_BYTES=4194304
MAX_INPUT_TEXT_CHARS=2000
DEMO_RATE_LIMIT_WINDOW_MINUTES=60
DEMO_RATE_LIMIT_MAX_REQUESTS=5
DEMO_GLOBAL_DAILY_LIMIT=50

DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
ENABLE_DAYTONA_PROCESSING=true
DAYTONA_CREATE_TIMEOUT_SECONDS=60
DAYTONA_EXECUTION_TIMEOUT_SECONDS=30
DAYTONA_STATE_TTL_HOURS=168

PLAYWRIGHT_HEADLESS=true
BROWSER_PROVIDER=local
BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io
BROWSERLESS_API_TOKEN=replace_with_browserless_token
BROWSER_SESSION_TIMEOUT_SECONDS=55
RESEARCH_TIME_BUDGET_SECONDS=240
MAX_MARKETPLACE_CARDS_SCANNED_PER_SOURCE=30
MAX_PRICE_SAMPLES_PER_SOURCE=5
MAX_VERIFIED_STORES=3
PRICE_CACHE_TTL_HOURS=24
STORE_CACHE_TTL_HOURS=168
TAVILY_API_KEY=your-tavily-api-key
ENABLE_TAVILY_PRICE_FALLBACK=true
MAX_TAVILY_SEARCH_CALLS=1
MAX_TAVILY_RESULTS=2
MAX_FALLBACK_DETAIL_PAGES=2
ALLOW_SECOND_FALLBACK_SEARCH=false
