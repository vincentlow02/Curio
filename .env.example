
# ========================================
# CURIO — ENVIRONMENT CONFIGURATION
# ========================================

# ----------------------------------------
# 1. Qwen AI — Product Identification
# ----------------------------------------
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=your-low-cost-qwen-text-model

# ----------------------------------------
# 2. Analytics (Optional)
# ----------------------------------------
# GA4 Measurement ID starts with G-
# Clarity Project ID is available in Settings
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ----------------------------------------
# 3. Application & Demo Limits
# ----------------------------------------
WEB_USE_FIXTURE=false
MAX_UPLOAD_BYTES=4194304
MAX_INPUT_TEXT_CHARS=2000

DEMO_RATE_LIMIT_WINDOW_MINUTES=60
DEMO_RATE_LIMIT_MAX_REQUESTS=5
DEMO_GLOBAL_DAILY_LIMIT=50

# ----------------------------------------
# 4. Browser Provider
# ----------------------------------------
# local = locally installed Playwright Chromium
# browserless = remote Chromium via CDP
# On Vercel, use a remote browser provider.
PLAYWRIGHT_HEADLESS=true
BROWSER_PROVIDER=local

BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io
BROWSERLESS_API_TOKEN=

BROWSER_SESSION_TIMEOUT_SECONDS=55
RESEARCH_TIME_BUDGET_SECONDS=240

# ----------------------------------------
# 5. Browser & Marketplace Costs
# ----------------------------------------
BROWSERLESS_COST_PER_TIME_UNIT_USD=
BROWSERLESS_COST_RATE_VERIFIED=false
MARKETPLACE_HTTP_COST_RATES_JSON={}

# ----------------------------------------
# 6. Rakuten Ichiba Official API
# ----------------------------------------
# Register at Rakuten Web Service.
# Keep credentials only in .env.local or
# server-side deployment environment variables.
#
# false = existing Rakuten Browser Provider
# true  = Rakuten Official HTTP API Provider
#
# Verify applicable API use conditions before
# enabling publicly.
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_OFFICIAL_API_ENABLED=false
RAKUTEN_GATEWAY_URL=
RAKUTEN_GATEWAY_AUTH_TOKEN=

# ----------------------------------------
# 7. Yahoo! Shopping Official API
# ----------------------------------------
# Enable only after applicable data-use
# and commercial-use conditions are verified.
YAHOO_SHOPPING_API_ENABLED=false
YAHOO_SHOPPING_APP_ID=

# Optional Janpara seller searches on Yahoo.
JANPARA_YAHOO_SHOPPING_STORE_SEARCH_ENABLED=false

# ----------------------------------------
# 8. Other Marketplace Access Gates
# ----------------------------------------
# Yahoo! Flea Market
YAHOO_FURIMA_DATA_LICENSE_VERIFIED=false

# Rakuma / Fril
RAKUMA_DATA_LICENSE_VERIFIED=false

# Surugaya Yahoo Shopping Store
SURUGAYA_YAHOO_STORE_DATA_LICENSE_VERIFIED=false

# ----------------------------------------
# 9. Marketplace Search Limits
# ----------------------------------------
MAX_MARKETPLACE_CARDS_SCANNED_PER_SOURCE=30
MAX_PRICE_SAMPLES_PER_SOURCE=5
MAX_VERIFIED_STORES=3

# ----------------------------------------
# 10. Cache Configuration
# ----------------------------------------
# Reserved configuration values.
# Search-result caching is not yet implemented.
PRICE_CACHE_TTL_HOURS=24
STORE_CACHE_TTL_HOURS=168

# ----------------------------------------
# 11. Tavily Fallback
# ----------------------------------------
TAVILY_API_KEY=your-tavily-api-key
ENABLE_TAVILY_PRICE_FALLBACK=true

MAX_TAVILY_SEARCH_CALLS=1
MAX_TAVILY_RESULTS=2
MAX_FALLBACK_DETAIL_PAGES=2
ALLOW_SECOND_FALLBACK_SEARCH=false
